# ==============================================================================
# InsureTrace India - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local Docker Compose runs.
# NEVER commit real production secrets or private keys to source control.

# Application Runtime Environment: development | staging | production
ENVIRONMENT=development

# Database & Supabase Integration (ap-south-1 Mumbai recommended)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-backend-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Backend API Configuration
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Blockchain & Ledger Configuration
# In production, ALLOW_MOCK_BLOCKCHAIN MUST be false.
ALLOW_MOCK_BLOCKCHAIN=false
GATEWAY_URL=http://localhost:3001
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=vehicle

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
