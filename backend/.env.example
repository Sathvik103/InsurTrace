# ==============================================================================
# InsureTrace India - Backend Environment Configuration Template
# ==============================================================================

# Runtime Environment: development | staging | production
ENVIRONMENT=development

# Supabase Database & Auth (Backend has service role access; never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-validation

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Blockchain Gateway
# URL to Node.js Fabric REST Gateway (or direct fallback to WSL FabricClient)
GATEWAY_URL=http://localhost:3001

# Mock Blockchain Toggle:
# Set to 'false' for real Hyperledger Fabric ledger transactions.
# In 'production' environment, mock mode is strictly forbidden by code regardless of this setting.
ALLOW_MOCK_BLOCKCHAIN=false

# Demo Authentication Toggle:
# Must be 'false' in production. When true (and not in production), permits development tokens.
ENABLE_DEMO_AUTH=true
