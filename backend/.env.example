# ==============================================================================
# VeriSure API - environment template (copy to backend/.env for local runs)
# Every variable is declared in backend/config.py.
# ==============================================================================

# development | test | production
ENVIRONMENT=development

# --- Data & identity (Supabase) ------------------------------------------------
# Leave SUPABASE_URL unset to run on the in-memory DEMO SANDBOX (fictional data,
# resets on restart). The status page reports which mode is active.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Project Settings -> API -> JWT secret. Required in production with Supabase.
SUPABASE_JWT_SECRET=

# Demo personas (dev-* tokens). Never honoured in production against a real
# Supabase project, regardless of this flag.
ENABLE_DEMO_AUTH=true

# Comma-separated browser origins. Must be explicit (no "*") in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Ledger (Hyperledger Fabric) ---------------------------------------------
# auto      : gateway if GATEWAY_URL set, else local peer CLI if Docker/WSL exists (dev only)
# gateway   : authenticated calls to backend/blockchain/gateway on a reachable host
# local_wsl : peer CLI against the local test network
# disabled  : no ledger; claims are saved with ledger status PENDING
FABRIC_MODE=auto
GATEWAY_URL=
GATEWAY_API_KEY=
# Optional: path to backend/blockchain as seen by the peer CLI (auto-detected).
FABRIC_BASE_DIR=
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=vehicle

# Development only. Ignored (and rejected at startup) in production.
ALLOW_MOCK_BLOCKCHAIN=false

# --- Abuse protection -------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_SENSITIVE=20/minute
MAX_UPLOAD_BYTES=10485760
