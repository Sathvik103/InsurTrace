# VeriSure Fabric gateway - runs on the same host as the Fabric peers.
PORT=3001
# Shared secret; set the same value as GATEWAY_API_KEY on the VeriSure API.
# Generate with: openssl rand -hex 32
GATEWAY_API_KEY=
# native (Linux host with the peer CLI) | wsl (Windows host, peers in WSL2)
FABRIC_RUNNER=native
# Directory containing bin/, config/ and fabric-samples/ (defaults to ../ of this file)
FABRIC_BASE_DIR=
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=vehicle
